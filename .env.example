# Telegram Bot Settings (primary channel profile)
# Either a single token, or _LOCAL/_PROD variants selected by BOT_ENV.
# BOT_ENV defaults to "local"; docker-compose forces BOT_ENV=prod on the VM,
# so the same .env file works in both environments.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_BOT_TOKEN_LOCAL=...
# TELEGRAM_BOT_TOKEN_PROD=...

# Optional branding for the primary profile (used in AI prompts and watermark-cover badge)
# BRAND_NAME=CodeOrCap
# BRAND_HANDLE=@codeorcap

# Content niche for the primary profile — drives AI title/description/tag prompts.
# Options: tech (fact-check style, default) | stories (Hinglish storytelling style)
# NICHE=tech

# ── Extra channel profiles ────────────────────────────────────────────────────
# Add a second bot/channel by prefixing vars with any name, e.g. STORIYUM_*.
# A profile is detected when <PREFIX>_TELEGRAM_BOT_TOKEN (or _LOCAL/_PROD) is set.
# BOT_ENV=local|prod selects between the _LOCAL and _PROD bot tokens (default: local).
#
# BOT_ENV=local
# STORIYUM_TELEGRAM_BOT_TOKEN_LOCAL=...
# STORIYUM_TELEGRAM_BOT_TOKEN_PROD=...
# STORIYUM_BRAND_NAME=StoriYum            # optional, defaults to prefix
# STORIYUM_BRAND_HANDLE=@storiyum         # optional, defaults to @<prefix>
# STORIYUM_NICHE=stories                  # optional content niche: tech (default) | stories
# STORIYUM_YOUTUBE_CLIENT_ID=...          # optional, falls back to YOUTUBE_CLIENT_ID
# STORIYUM_YOUTUBE_CLIENT_SECRET=...      # optional, falls back to YOUTUBE_CLIENT_SECRET
# STORIYUM_YOUTUBE_REDIRECT_URI=...       # optional, falls back to YOUTUBE_REDIRECT_URI
# STORIYUM_YOUTUBE_REFRESH_TOKEN=...      # or STORIYUM_YOUTUBE_CHANNEL_1_REFRESH_TOKEN etc.
# STORIYUM_INSTAGRAM_ACCESS_TOKEN=...
# STORIYUM_INSTAGRAM_USER_ID=...
# STORIYUM_INSTAGRAM_USERNAME=your_secondary_instagram_username_here
# STORIYUM_INSTAGRAM_PASSWORD=your_secondary_instagram_password_here
# STORIYUM_INSTAGRAM_TOTP_SECRET=your_secondary_totp_secret_here


# YouTube Data API v3 OAuth2 Credentials
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
# "Sign in with Google" redirect target. It must EXACTLY match an "Authorized
# redirect URI" in Google Cloud Console → Credentials → your OAuth client.
#   • Local dev:  leave unset → auto-derives http://localhost:3001/oauth2callback
#                 (a small listener runs on YOUTUBE_OAUTH_PORT, default 3001)
#   • Prod:       set to your public dashboard URL so the flow works in-browser
#                 with no local machine step:
# YOUTUBE_REDIRECT_URI=https://shorts-automation.duckdns.org/oauth2callback
# YOUTUBE_OAUTH_PORT=3001
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# Instagram Graph API Credentials (for publishing reels/posts)
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_api_access_token_here
INSTAGRAM_USER_ID=your_instagram_business_account_id_here

# "Connect with Facebook" button in the dashboard (one-click token instead of
# pasting from Graph API Explorer). Needs the FB app's ID + Secret, and the
# redirect URI below must be added to: App → Facebook Login → Settings →
# Valid OAuth Redirect URIs.
# META_APP_ID=1444349357451297
# META_APP_SECRET=your_facebook_app_secret
# META_REDIRECT_URI=https://shorts-automation.duckdns.org/meta/oauth2callback

# Instagram channel-watch auth (instagrapi — for fetching reels from source channels)
# Session is saved to logs/instagrapi_session.json after first login so credentials
# are only used once per session expiry (~90 days). Use the account you watch FROM,
# not the publishing account.
CODEORCAP_INSTAGRAM_USERNAME=your_instagram_username_for_codeorcap
CODEORCAP_INSTAGRAM_PASSWORD=your_instagram_password_for_codeorcap
# CODEORCAP_INSTAGRAM_TOTP_SECRET=your_totp_secret_for_codeorcap  # only needed if 2FA is enabled (also: pip install pyotp)

# Legacy fallback (overridden by profile-specific prefixes like CODEORCAP_*, STORIYUM_*, PROMPT_GAG_*)
# INSTAGRAM_USERNAME=your_instagram_username
# INSTAGRAM_PASSWORD=your_instagram_password
# INSTAGRAM_TOTP_SECRET=your_totp_secret

# ── Instagram scraper hardening ──────────────────────────────────────────────
# session_only (default): the server NEVER does a username/password login. Only
#   the sessionid cookie / persisted device blob (stored in the channel_credentials
#   DB table) are used. When the cookie dies, ingestion pauses and an admin is
#   pinged on Telegram to paste a fresh cookie via the dashboard. This avoids the
#   Instagram challenge that a datacenter-IP password login reliably triggers.
# LOGIN_FREE_MODE=true
#   Set to true (or INSTAGRAM_LOGIN_MODE=login_free) to completely bypass Instagram login
#   and session cookies. Uses public search engines (DuckDuckGo/Bing) to find viral reels
#   zero credentials or cookies needed.
# INSTAGRAM_LOGIN_MODE=session_only
#
# Optional proxy — routes every Instagram call through a residential/mobile IP so
# challenges stop and the automatic session refresh actually works. Per-profile
# override: CODEORCAP_INSTAGRAM_PROXY, STORIYUM_INSTAGRAM_PROXY, ...
# INSTAGRAM_PROXY=http://user:pass@host:port
#
# Tuning (defaults shown): delay between polling consecutive channels, and how
# long a profile pauses ingestion after hitting a 429.
# INSTAGRAM_INTER_CHANNEL_DELAY_MS=25000
# INSTAGRAM_RATE_LIMIT_COOLDOWN_MS=2700000

# Headless Chromium: --single-process cuts RAM but hangs page.evaluate() under
# CPU contention. Off by default; set to 1 only if plain Chromium OOMs at launch.
# PUPPETEER_SINGLE_PROCESS=1

# Companion 5-min YouTube video: spawns a 2nd heavy render + Chromium per publish.
# Off by default (was failing + starving the pipeline on the 1GB box).
# AUTO_LONG_VIDEO_ENABLED=true

# TTS fallback: OpenAI's official speech API is used when Edge TTS fails, if
# OPENAI_API_KEY is set. Override the model if needed.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
#
# RapidAPI Instagram scraper key — leave unset unless you have a paid key. The
# old shared free-tier key is exhausted and is now ignored automatically.
# RAPIDAPI_INSTAGRAM_KEY=

# AI Provider Settings (options: freellmapi, claude, antigravity, mock)
# freellmapi   → FreeLLMAPI OpenAI-compatible proxy (for routing / fallbacks)
# claude       → Claude CLI generates structured JSON → SVG infographic
# antigravity  → agy CLI generates structured JSON → SVG infographic
# mock         → classic SVG+Sharp pipeline, no AI
AI_PROVIDER=freellmapi
CLAUDE_CLI_PATH=claude
ANTIGRAVITY_CLI_PATH=agy

# FreeLLMAPI Settings (required only if AI_PROVIDER=freellmapi)
FREELLMAPI_URL=http://localhost:3001
FREELLMAPI_KEY=your_freellmapi_unified_key_here
FREELLMAPI_MODEL=auto
FREELLMAPI_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# Path Configurations (Relative to project root or Absolute paths)
ASSETS_DIR=assets
MUSIC_DIR=assets/music
TEMP_DIR=temp
OUTPUT_DIR=output
LOG_DIR=logs

# Video Rendering Defaults
VIDEO_DURATION_SECONDS=15
VIDEO_FPS=30
MUSIC_VOLUME=0.12

# Copyright / Content-ID pre-check (AcoustID + Chromaprint)
# Free API key: https://acoustid.org/new-application
# Install fpcalc: brew install chromaprint
COPYRIGHT_CHECK_ENABLED=true
ACOUSTID_API_KEY=your_acoustid_api_key_here
# Final pre-publish gate: Shazam the finished audio and strip any recognisable music (default on)
AUDIO_CLEARANCE_ENABLED=true
# Library music tracks (default false). Videos get a generated non-musical ambient bed instead
BACKGROUND_MUSIC_ENABLED=false
FPCALC_PATH=fpcalc

# ── Channel Watch Automation ──────────────────────────────────────────────────
# Automatically discover and queue Instagram reels once a day.
# WATCH_CHANNELS=username1,username2   # comma-separated Instagram usernames to watch
# WATCH_DAILY_COUNT=5                  # reels to pick per day (default: 5)
# WATCH_SCHEDULE_TIME=09:00            # IST time HH:MM to run daily batch (default: 09:00)
# WATCH_GAP_HOURS=2                    # hours between each published reel (default: 2)
# WATCH_ADMIN_CHAT_ID=0                # Telegram chat ID for auto-publish results (0 = off)
#
# Niche + viral auto-search (optional — defaults to 'channels' mode)
# WATCH_SEARCH_MODE=channels           # channels | hashtags | both (default: channels)
# WATCH_NICHE_HASHTAGS=programming,coding,developer  # override auto-generated hashtags
# WATCH_MOOD_FILTER=funny,emotional    # preferred moods passed as AI metadata hint
# WATCH_VIRAL_THRESHOLD=50             # 0-100 min viral score to include (default: 50, fail-open)

# ── DuckDNS Configuration (Free Clean HTTPS Address) ───────────────────────────
# 1. Log in to https://www.duckdns.org (Free via GitHub/Google)
# 2. Add subdomain "shorts-automation" -> points to your server IP
# 3. Copy your token from top of page
DUCKDNS_SUBDOMAIN=shorts-automation
DUCKDNS_TOKEN=your_duckdns_token_here

# my-video (Remotion/stickman repo). Defaults to ./my-video then ../my-video
# MY_VIDEO_DIR=/absolute/path/to/my-video

# Dashboard login (REQUIRED). One password; the browser then stays signed in for 180 days (signed cookie).
# Scripts can send "Authorization: Bearer <password>". Changing it signs everyone out.
# Without it the server makes up a temporary password on each start and prints it to the container stdout.
DASHBOARD_PASSWORD=choose_a_long_random_password
# Optional extra secret mixed into the cookie signature
# DASHBOARD_SESSION_SECRET=

# CodeOrCap Shorts in ONE cloned voice (your own voice, spoken on GitHub Actions by Voicebox): the claim narration, the how-it-works clip
# and the verdict. On by default when GITHUB_TOKEN is set; "off" brings back the Edge voice and the recorded verdict audio.
# CLONED_VOICE=off
# Give up on the cloud run after this many minutes (default 20) and use the normal voice for that Short
# CLONED_VOICE_TIMEOUT_MIN=20

# Shared Shorts publishing grid: 5 Shorts per channel between 07:00 and 22:00 IST, no two channels at the same minute
# (channel k takes slots k, k+4, ...; 45 min between slots, so 3 h between one channel's Shorts).
# ON by default. SHORTS_GRID=off returns to the old scheduleTime/gapHours behaviour (the grid is still logged).
# SHORTS_GRID=off
# SHORTS_GRID_START=07:00
# SHORTS_GRID_STEP_MIN=45
# SHORTS_PER_DAY=5
# SHORTS_GRID_END=22:00

# ── Daily 10-minute video per channel (src/longvideo-auto) ────────────────────────────────────────────────────────
# After midnight IST the day's published Shorts are ranked per channel; the best one becomes a researched, scripted
# (Hindi, Devanagari) 10-minute stickman video in the channel's cloned voice, made one channel at a time while no Short is
# being processed, uploaded private and released by YouTube itself in the channel's evening slot (18:37/19:22/20:07/20:52 IST).
# ON by default. DAILY_LONG_VIDEO=off stops it (Shorts are still recorded as candidates).
# NOTE: AUTO_LONG_VIDEO_ENABLED is a DIFFERENT, older feature (the 5-minute "companion" video). Leave it unset.
# DAILY_LONG_VIDEO=off
# DAILY_LONG_CHANNELS=codeorcap,storiyum,prompt_gag,infoonspot
# AUTO_LONG_LLM_TIMEOUT_MS=150000
# Status (needs the dashboard login): GET /api/autolong/status. Log lines: [AutoLong][stage][request].

# V2 Short: the stickman clip in the middle. codeorcap = how it works, storiyum = moral/punchline,
# prompt_gag = current market/opinion, infoonspot = opinion/reaction.
# ON for all four by default. A list limits it; "off" removes it everywhere.
# INSIGHT_CLIP_CHANNELS=codeorcap,storiyum
# INSIGHT_CLIP_LANG=en        # en | hi: language of the clip's first line
