# AI Provider Settings (options: claude, antigravity, mock, freellmapi)
# 'mock' uses local NLP keywords processing on the OCR text and works without API keys
AI_PROVIDER=freellmapi
CLAUDE_CLI_PATH=claude
ANTIGRAVITY_CLI_PATH=agy

# FreeLLMAPI Settings (Uncomment AI_PROVIDER=freellmapi to enable)
# For local running: http://localhost:3001
# For docker-compose running on Oracle: http://freellmapi:3001
