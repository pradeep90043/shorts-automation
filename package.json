{
  "name": "shorts-automation",
  "version": "1.0.0",
  "description": "AI-Powered Telegram → CodeOrCap → YouTube Shorts Automation System",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "postbuild": "npm run test:pipeline",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src -e ts --exec ts-node src/index.ts",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'",
    "get-token": "ts-node get-refresh-token.ts",
    "scan:music": "ts-node scripts/scan-music-library.ts",
    "test:vision": "ts-node tests/vision.test.ts",
    "test:ocr": "ts-node tests/ocr.test.ts",
    "test:caption": "ts-node tests/caption.test.ts",
    "test:safearea": "ts-node tests/safearea.test.ts",
    "test:render": "ts-node tests/render.test.ts",
    "test:ffmpeg": "ts-node tests/ffmpeg.test.ts",
    "test:youtube": "ts-node tests/youtube.test.ts",
    "test:pipeline": "ts-node tests/pipeline.test.ts",
    "test:format-test": "ts-node tests/format-test.test.ts",
    "test:list-card": "ts-node tests/list-card.test.ts",
    "test:image-voice": "ts-node tests/image-voice.test.ts",
    "test:run-format": "ts-node tests/run-format.test.ts",
    "test:format-report": "ts-node tests/format-report.test.ts",
    "format:report": "ts-node scripts/format-report.ts",
    "test:plan-import": "ts-node tests/plan-import.test.ts",
    "test:planner-resume": "ts-node tests/planner-resume.test.ts",
    "test:howitworks-clip": "ts-node tests/howitworks-clip.test.ts",
    "test:scene-composer": "ts-node tests/scene-composer.test.ts",
    "test:code-tutorial": "ts-node tests/code-tutorial.test.ts",
    "test:tts-fit": "ts-node tests/tts-fit.test.ts",
    "test:verdict-number": "ts-node tests/verdict-number.test.ts",
    "test:dashboard-auth": "ts-node tests/dashboard-auth.test.ts",
    "test:voicebox-narration": "ts-node tests/voicebox-narration.test.ts",
    "test:cloned-voice": "ts-node tests/cloned-voice.test.ts",
    "test:cover-image": "ts-node tests/cover-image.test.ts",
    "test:ig-caption": "ts-node tests/ig-caption.test.ts",
    "verify": "node scripts/verify.js",
    "dm:chat": "ts-node src/instagram/dm/cli.ts chat",
    "dm:knowledge": "ts-node src/instagram/dm/cli.ts knowledge",
    "dm:outbound": "ts-node src/instagram/dm/cli.ts outbound",
    "dm:daemon": "ts-node src/instagram/dm/cli.ts daemon",
    "dm:trigger": "ts-node scripts/trigger-dm.ts"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "dotenv": "^16.4.5",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^137.1.0",
    "mongodb": "^7.5.0",
    "node-edge-tts": "^1.2.10",
    "openai": "^6.47.0",
    "pg": "^8.22.0",
    "puppeteer": "^24.43.1",
    "puppeteer-core": "^25.2.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sharp": "^0.33.4",
    "tesseract.js": "^5.1.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^20.12.12",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
